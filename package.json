{
  "name": "@visual-regression-tracker/agent-codeceptjs",
  "version": "4.6.1",
  "description": "CodeceptJS helper for Visual Regression Tracker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:cov": "jest --collectCoverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visual-Regression-Tracker/agent-codeceptjs.git"
  },
  "keywords": [
    "codeceptjs",
    "visual-regression",
    "visual-regression-tracker"
  ],
  "author": "Pavel Strunkin",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Visual-Regression-Tracker/agent-codeceptjs/issues"
  },
  "homepage": "https://github.com/Visual-Regression-Tracker/agent-codeceptjs#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "codeceptjs": "^3.7.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "codeceptjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@codeceptjs/helper": "^2.0.4",
    "@visual-regression-tracker/sdk-js": "^5.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "jest": "^30.5.2",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
