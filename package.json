{
  "name": "@visual-regression-tracker/agent-codeceptjs",
  "version": "0.0.0-development",
  "description": "CodeceptJS helper for Visual Regression Tracker",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.spec.json && vitest run",
    "test:cov": "tsc -p tsconfig.spec.json && vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Visual-Regression-Tracker/agent-codeceptjs.git"
  },
  "keywords": [
    "codeceptjs",
    "visual-regression",
    "visual-regression-tracker"
  ],
  "author": "Pavel Strunkin",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Visual-Regression-Tracker/agent-codeceptjs/issues"
  },
  "homepage": "https://github.com/Visual-Regression-Tracker/agent-codeceptjs#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "codeceptjs": "^3.7.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "codeceptjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@codeceptjs/helper": "^2.0.4",
    "@visual-regression-tracker/sdk-js": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "next",
        "prerelease": "rc"
      }
    ],
    "preset": "conventionalcommits"
  }
}
