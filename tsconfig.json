{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./lib",
    "outDir": "./dist",
    "types": ["node", "jest"]
  },
  "include": ["lib/**/*"],
  "exclude": ["**/*.spec.*"]
}
